# Copy this file to .env.local and fill in each value.
# Values come from Supabase dashboard → Project Settings → API Keys / Data API.
# .env.local is git-ignored. Never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET: bypasses all database security. Server only. Never add NEXT_PUBLIC_ to this.
SUPABASE_SERVICE_ROLE_KEY=

# http://localhost:3000 when running locally; your live URL on Vercel.
NEXT_PUBLIC_SITE_URL=
